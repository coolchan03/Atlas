{
  "id": "./",
  "name": "Atlas: offline AI, library and field guide",
  "short_name": "Atlas",
  "description": "An offline AI, library and field guide. The model runs on your device, nothing is sent anywhere.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
  "categories": [
    "productivity",
    "education",
    "utilities"
  ],
  "lang": "en",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New chat",
      "short_name": "Chat",
      "url": "./?open=chat",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Voice call",
      "short_name": "Call",
      "url": "./?open=call",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Recorder",
      "short_name": "Record",
      "url": "./?open=record",
      "icons": [
        {
          "src": "icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./?share-target=1",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./?open-file=1",
      "accept": {
        "application/octet-stream": [
          ".gguf"
        ],
        "text/plain": [
          ".txt",
          ".md"
        ],
        "application/pdf": [
          ".pdf"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "prefer_related_applications": false,
  "screenshots": [
    {
      "src": "screenshots/wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Atlas home on a computer"
    },
    {
      "src": "screenshots/narrow.png",
      "sizes": "412x860",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Atlas home on a phone"
    }
  ]
}